{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "earthbound/contact-form",
    "version": "1.0.0",
    "title": "Contact Form",
    "category": "earthbound",
    "icon": "email",
    "description": "A contact form that emails submissions to the site owner.",
    "keywords": ["contact", "form", "email", "message"],
    "textdomain": "earthbound",
    "supports": {
        "html": false,
        "className": true,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "interactivity": true
    },
    "attributes": {
        "submitLabel": {
            "type": "string",
            "default": "Send Message"
        }
    },
    "viewScriptModule": "file:./view.js",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
